# Entorno recomendado para despliegue web del backend v0.2

APP_ENV=production
WEB_ADAPTER=fastapi

# URL publica de la base de datos relacional
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/programacion_numerica

# Logging SQL: desactivar en produccion salvo depuracion puntual
DATABASE_ECHO=false

# En produccion conviene aplicar migraciones con Alembic en lugar de crear tablas implicitamente
AUTO_CREATE_SCHEMA=false

# Debe reemplazarse por un secreto largo, unico y privado
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Host y puerto del proceso ASGI
APP_HOST=0.0.0.0
APP_PORT=8000

# Origenes permitidos para el frontend publicado
CORS_ALLOW_ORIGINS=https://tu-frontend.example.com
CORS_ALLOW_CREDENTIALS=false